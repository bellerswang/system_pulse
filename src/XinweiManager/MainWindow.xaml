<Window x:Class="XinweiManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="System Pulse" Icon="/SystemPulse;component/Assets/Brand/SystemPulse.ico"
        Width="1080" Height="800" MinWidth="850" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" IsVisibleChanged="Window_IsVisibleChanged"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="ProcessBar" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="Transparent">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    Opacity="0.13" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ProcessRowTemplate">
            <Border BorderBrush="#294055" BorderThickness="0,0,0,1">
                <Grid Height="43">
                    <ProgressBar Value="{Binding RelativePercent, Mode=OneWay}" Foreground="{Binding Accent}"
                                 Style="{StaticResource ProcessBar}" IsHitTestVisible="False"/>
                    <Canvas Width="120" Height="40" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Opacity="0.42" IsHitTestVisible="False">
                        <Polygon Points="{Binding AreaPoints}" Fill="{Binding Accent}" Opacity="0.26"/>
                        <Polyline Points="{Binding TrendPoints}" Stroke="{Binding Accent}" StrokeThickness="2"/>
                    </Canvas>
                    <Grid Margin="4,0,4,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rank}" Foreground="{StaticResource YellowBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PidLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" Foreground="{Binding Accent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Context}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{StaticResource YellowBrush}" BorderThickness="0,0,0,2" Background="#101B29" ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <ImageBrush ImageSource="/SystemPulse;component/Assets/Textures/circuit-surface.png"
                                Stretch="UniformToFill" Opacity="0.56" AlignmentY="Center"/>
                </Grid.Background>
                <Border Background="#B3080D16"/>
                <Grid Margin="17,0,9,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="/SystemPulse;component/Assets/Brand/SystemPulse.png" Width="39" Height="39"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM // PULSE" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="Bold"
                                   FontStyle="Italic" Foreground="{StaticResource YellowBrush}"/>
                        <TextBlock Text="LOCAL DEVICE CONSOLE" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" Margin="2,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" ToolTip="Minimise" Click="Minimise_Click" Width="38" Height="31"
                                Padding="0" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximiseButton" Content="□" ToolTip="Maximise" Click="Maximise_Click" Width="38" Height="31"
                                Padding="0" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="×" ToolTip="Hide to tray" Click="Close_Click" Width="38" Height="31"
                                Padding="0" Foreground="{StaticResource PinkBrush}" BorderBrush="{StaticResource PinkBrush}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}">
                    <StackPanel Margin="0,12,5,12">
                        <DockPanel Margin="0,0,9,12">
                            <TextBlock Text="{Binding LastUpdated, StringFormat=UPDATED  {0}}" DockPanel.Dock="Right"
                                       FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       VerticalAlignment="Bottom"/>
                            <StackPanel>
                                <TextBlock Text="DASHBOARD" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="LIVE STATUS  /  EXPAND CPU OR MEMORY FOR PROCESSES"
                                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" BorderBrush="{StaticResource CyanBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="01 / CPU USAGE" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="PROCESSOR" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CpuUsage}" Style="{StaticResource BigValue}"/>
                                    <ProgressBar Value="{Binding CpuLoad, Mode=OneWay}" Style="{StaticResource Meter}"/>
                                    <TextBlock Text="System-wide processor load" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                                    <Button Content="{Binding CpuToggleLabel}" Command="{Binding ToggleCpuCommand}" HorizontalAlignment="Left"/>
                                    <StackPanel Visibility="{Binding CpuExpanded, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding CpuProcessStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding CpuProcesses}" ItemTemplate="{StaticResource ProcessRowTemplate}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" BorderBrush="{StaticResource PinkBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="02 / MEMORY USAGE" Style="{StaticResource SectionTitle}" Foreground="{StaticResource PinkBrush}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="PHYSICAL RAM" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding MemoryUsage}" Style="{StaticResource BigValue}"/>
                                    <ProgressBar Value="{Binding MemoryLoad, Mode=OneWay}" Style="{StaticResource Meter}" Foreground="{StaticResource PinkBrush}"/>
                                    <TextBlock Text="{Binding MemoryDetail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"/>
                                    <Button Content="{Binding MemoryToggleLabel}" Command="{Binding ToggleMemoryCommand}" HorizontalAlignment="Left"
                                            Foreground="{StaticResource PinkBrush}" BorderBrush="{StaticResource PinkBrush}"/>
                                    <StackPanel Visibility="{Binding MemoryExpanded, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding MemoryProcessStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding MemoryProcesses}" ItemTemplate="{StaticResource ProcessRowTemplate}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="03 / CPU TEMPERATURE" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding CpuTemperature}" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding CpuSensors}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Device}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:0} °C}" Foreground="{StaticResource CyanBrush}"
                                                           FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="04 / GPU TEMPERATURE" Style="{StaticResource SectionTitle}" Foreground="{StaticResource PinkBrush}"/>
                                    <TextBlock Text="{Binding GpuTemperature}" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="GPU USAGE" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="10" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GpuUsage}" Foreground="{StaticResource PinkBrush}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding GpuLoad, Mode=OneWay}" Style="{StaticResource Meter}"
                                                 Foreground="{StaticResource PinkBrush}" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding GpuSensors}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Device}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:0} °C}" Foreground="{StaticResource PinkBrush}"
                                                           FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="05 / FANS" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding FansStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Fans}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Device}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:0} RPM}" Foreground="{StaticResource CyanBrush}"
                                                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Cleanup">
                <Grid Margin="0,12,5,12" Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="CLEANUP" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="PERSONAL STORAGE TOOLS  /  REVIEW BEFORE ACTION" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,9">
                        <Button Content="TEMPORARY FILES" Command="{Binding ShowTemporaryFilesCommand}" Margin="0,0,8,0"/>
                        <Button Content="LARGE FILES" Command="{Binding ShowLargeFilesCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTemporaryFilesMode, Converter={StaticResource BoolVisibility}}">
                            <Button Content="SCAN TEMPORARY FILES" Command="{Binding ScanCommand}" Margin="0,0,10,0"/>
                            <Button Content="CLEAN NOW" Command="{Binding CleanCommand}" Margin="0,0,10,0" Foreground="{StaticResource YellowBrush}" BorderBrush="{StaticResource YellowBrush}"/>
                            <Button Content="CANCEL" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                        <Border Visibility="{Binding IsLargeFilesMode, Converter={StaticResource BoolVisibility}}"
                                Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                    <Button Content="ADD FOLDER" Command="{Binding AddLargeFolderCommand}" DockPanel.Dock="Right" Padding="10,6"/>
                                    <TextBlock Text="SEARCH LOCATIONS  /  PERSONAL FOLDERS ONLY" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding LargeFileLocations}" Margin="0,0,0,7">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding Path}" Margin="0,2,18,2" Foreground="{StaticResource TextBrush}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Grid.Row="2">
                                    <Button Content="SEARCH LARGE FILES" Command="{Binding SearchLargeFilesCommand}"
                                            DockPanel.Dock="Right" Foreground="{StaticResource YellowBrush}" BorderBrush="{StaticResource YellowBrush}"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="AT LEAST" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding LargeFileSizeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding LargeFileMinimumMegabytes, Mode=TwoWay}" Width="92" Height="32"
                                                  Background="{StaticResource PanelBrush}" Foreground="{StaticResource CyanBrush}" BorderBrush="{StaticResource LineBrush}"/>
                                        <TextBlock Text="AND NOT MODIFIED FOR" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding LargeFileAgeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding LargeFileAgeDays, Mode=TwoWay}" Width="100" Height="32"
                                                  Background="{StaticResource PanelBrush}" Foreground="{StaticResource CyanBrush}" BorderBrush="{StaticResource LineBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="3" Text="System and software folders are excluded. Online-only OneDrive files are skipped."
                                           FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                        <StackPanel Visibility="{Binding IsTemporaryFilesMode, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="TEMPORARY FILE REVIEW" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding CleanupStatus}" FontSize="14" Margin="0,0,0,7"/>
                            <TextBlock Text="{Binding Estimated, StringFormat=Estimated space: {0}}" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text="{Binding CleanupResult}" Foreground="{StaticResource PinkBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsLargeFilesMode, Converter={StaticResource BoolVisibility}}">
                            <DockPanel Margin="0,0,0,5">
                                <Button Content="CANCEL" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Padding="10,6"/>
                                <TextBlock Text="{Binding LargeFilesStatus}" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <Button Content="MOVE SELECTED TO RECYCLE BIN" Command="{Binding MoveLargeFilesCommand}"
                                        DockPanel.Dock="Right" Foreground="{StaticResource PinkBrush}" BorderBrush="{StaticResource PinkBrush}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LargeFilesSelectedSummary}" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="SELECT ALL" Command="{Binding SelectAllLargeFilesCommand}" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Content="CLEAR" Command="{Binding ClearLargeFileSelectionCommand}" Padding="8,5"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding LargeFilesActionResult}" Foreground="{StaticResource PinkBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTemporaryFilesMode, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Root}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat={}{0:N0} B}" Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LastWriteUtc, StringFormat={}{0:dd MMM yyyy HH:mm} UTC}" Foreground="{StaticResource MutedBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLargeFilesMode, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding LargeFileItems}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}"/>
                                                <TextBlock Text="{Binding Root}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LastModified}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Hardware">
                <Grid Margin="0,12,5,12" Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="REFRESH" Command="{Binding RefreshHardwareCommand}" DockPanel.Dock="Right"/>
                        <StackPanel>
                            <TextBlock Text="HARDWARE" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="DEVICE INVENTORY  /  LOCAL READOUT" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding HardwareStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Hardware}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,4" FontSize="13"/>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
