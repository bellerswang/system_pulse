<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SystemPulse</AssemblyName>
    <Product>System Pulse</Product>
    <ApplicationIcon>Assets\Brand\SystemPulse.ico</ApplicationIcon>
    <RootNamespace>XinweiManager</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Textures\*.png" />
    <Resource Include="Assets\Brand\SystemPulse.png" />
    <Resource Include="Assets\Brand\SystemPulse.ico" />
  </ItemGroup>
</Project>
