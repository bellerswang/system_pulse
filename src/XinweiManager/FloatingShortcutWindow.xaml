<Window x:Class="XinweiManager.FloatingShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open System Pulse" Width="294" Height="174"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" MouseLeftButtonUp="Shortcut_Click">
    <Window.Resources>
        <Style x:Key="DeckMeter" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="#293A4A" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent" Cursor="Hand" ToolTip="Open System Pulse · live CPU, GPU and memory telemetry">
        <Path Data="M 12,2 L 274,2 L 292,20 L 292,154 L 282,172 L 2,172 L 2,14 Z"
              Fill="#F00B1422" Stroke="#8064EFFF" StrokeThickness="1.2">
            <Path.Effect>
                <DropShadowEffect Color="#00DFFF" BlurRadius="17" ShadowDepth="0" Opacity="0.42"/>
            </Path.Effect>
        </Path>
        <Path Data="M 13,4 L 270,4 L 289,23" Stroke="#FCEE0A" StrokeThickness="2.5" Fill="Transparent"/>
        <Path Data="M 289,129 L 289,153 L 281,168" Stroke="#FF4AAE" StrokeThickness="2.5" Fill="Transparent"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False">
            <Rectangle Width="3" Height="8" Fill="#00E5FF" Margin="0,0,0,4"/>
            <Rectangle Width="3" Height="8" Fill="#FCEE0A" Margin="0,0,0,4"/>
            <Rectangle Width="3" Height="8" Fill="#FF4AAE"/>
        </StackPanel>
        <Grid Margin="23,13,19,12" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
                <TextBlock Text="CYBERDECK" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                           Foreground="#FCEE0A" DockPanel.Dock="Left"/>
                <TextBlock Text="// LIVE TELEMETRY" FontFamily="{StaticResource DisplayFont}" FontSize="9"
                           Foreground="#91A6B8" VerticalAlignment="Center" Margin="8,1,0,0" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Ellipse Width="6" Height="6" Fill="#00E5FF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="ONLINE" FontFamily="{StaticResource DisplayFont}" FontSize="8" FontWeight="Bold"
                               Foreground="#00E5FF" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,3,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#B9121E2C" BorderBrush="#575B7982" BorderThickness="1" Padding="9,5,8,4">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="CPU // THERMAL" FontFamily="{StaticResource DisplayFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="#00E5FF"/>
                            <TextBlock Text="CORE" FontFamily="{StaticResource DisplayFont}" FontSize="8"
                                       Foreground="#778DA1" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding FloatingCpuTemperature}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" FontWeight="Bold" Foreground="#F4F7FB" VerticalAlignment="Center"/>
                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <TextBlock Text="LOAD" FontFamily="{StaticResource DisplayFont}" FontSize="8" FontWeight="Bold"
                                       Foreground="#91A6B8" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding FloatingCpuUsage}" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                       FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="7,0,0,0" DockPanel.Dock="Right"/>
                            <ProgressBar Value="{Binding CpuLoad, Mode=OneWay}" Foreground="#00E5FF" Height="4"
                                         VerticalAlignment="Center" Style="{StaticResource DeckMeter}"/>
                        </DockPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#B9121E2C" BorderBrush="#775D465C" BorderThickness="1" Padding="9,5,8,4">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="GPU // THERMAL" FontFamily="{StaticResource DisplayFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="#FF4AAE"/>
                            <TextBlock Text="CORE" FontFamily="{StaticResource DisplayFont}" FontSize="8"
                                       Foreground="#778DA1" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding FloatingGpuTemperature}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" FontWeight="Bold" Foreground="#F4F7FB" VerticalAlignment="Center"/>
                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <TextBlock Text="LOAD" FontFamily="{StaticResource DisplayFont}" FontSize="8" FontWeight="Bold"
                                       Foreground="#91A6B8" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding FloatingGpuUsage}" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                       FontWeight="Bold" Foreground="#FF4AAE" VerticalAlignment="Center" Margin="7,0,0,0" DockPanel.Dock="Right"/>
                            <ProgressBar Value="{Binding GpuLoad, Mode=OneWay}" Foreground="#FF4AAE" Height="4"
                                         VerticalAlignment="Center" Style="{StaticResource DeckMeter}"/>
                        </DockPanel>
                    </Grid>
                </Border>
                <Rectangle Grid.Column="1" Width="1" Fill="#45657B" VerticalAlignment="Stretch"/>
            </Grid>
            <Border Grid.Row="2" Background="#AA101A28" BorderBrush="#48566B7D" BorderThickness="1" Padding="9,5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RAM" FontFamily="{StaticResource DisplayFont}" FontSize="10" FontWeight="Bold" Foreground="#FF4AAE"/>
                        <TextBlock Text="MEMORY" FontFamily="{StaticResource DisplayFont}" FontSize="7" Foreground="#91A6B8"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Value="{Binding MemoryLoad, Mode=OneWay}" Foreground="#FF4AAE"
                                 Height="5" VerticalAlignment="Center" Style="{StaticResource DeckMeter}"/>
                    <TextBlock Grid.Column="2" Text="{Binding FloatingMemoryUsage}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="Bold" Foreground="#FF4AAE" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
